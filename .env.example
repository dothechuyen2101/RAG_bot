# Copy file này thành .env rồi điền API key.

# Provider sinh câu trả lời + OCR: wellflow | gemini | openai
LLM_PROVIDER=wellflow
# Provider tạo embedding: gemini | openai (Wellflow chưa có API embedding)
# Đổi provider/model embedding thì phải bấm "Re-index" cho từng bộ tài liệu.
EMBED_PROVIDER=gemini

# --- Gemini (lấy key tại https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Model dự phòng, dùng khi model chính báo quá tải (503/429) hoặc quá chậm.
# gemini-3.8-flash mạnh nhất nhưng hiện rất chậm (90-180 giây mỗi câu), nên để cuối.
# Gói miễn phí: khoảng 20 lượt/ngày cho MỖI model, đặt lại lúc ~15h giờ Việt Nam.
# Hết lượt ở model này bot tự chuyển sang model kế tiếp trong danh sách dự phòng.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# low | medium | high
GEMINI_THINKING_LEVEL=low
GEMINI_EMBED_MODEL=gemini-embedding-2
# 768 | 1536 | 3072
GEMINI_EMBED_DIM=1536

# --- Wellflow (gateway tương thích OpenAI; https://wellflow.dev/dashboard/docs/) ---
WELLFLOW_API_KEY=
# Thiếu /v1 thì app tự thêm
WELLFLOW_BASE_URL=https://api.wellflow.dev/v1
# Model chat phải đọc được ảnh vì cũng dùng để OCR PDF scan.
# Đo thử: claude-opus-5-5 tốt nhất nhưng chậm hơn; claude-haiku-5.5 nhanh nhất (chat ~5 giây).
WELLFLOW_CHAT_MODEL=claude-opus-5-5
# Model dự phòng khi model chính treo (>30 giây) hoặc quá tải
WELLFLOW_FALLBACK_MODELS=claude-sonnet-5-5,claude-haiku-5.5
# Wellflow chưa hỗ trợ /v1/embeddings (trả 501), nên để trống và giữ EMBED_PROVIDER=gemini.
WELLFLOW_EMBED_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
# gpt-6.1-terra (cân bằng) | gpt-6-luna (rẻ nhất) | gpt-6.1-sol (mạnh hơn)
OPENAI_CHAT_MODEL=gpt-6.1-terra
# none | low | medium | high
OPENAI_REASONING_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Tavily (tìm kiếm internet, https://app.tavily.com) ---
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# --- Tìm kiếm trong tài liệu ---
# Số đoạn tài liệu đưa cho LLM mỗi câu hỏi
TOP_K=8
# Nếu > 0: đoạn tốt nhất có độ tương đồng cosine thấp hơn ngưỡng này thì coi như
# không tìm thấy, khỏi gọi LLM. Mặc định 0 = tắt, để LLM tự đánh giá.
MIN_SIMILARITY=0
# Số trang OCR song song
OCR_WORKERS=4
