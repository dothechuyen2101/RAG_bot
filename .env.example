# Copy file này thành .env rồi điền API key.

# Provider sinh câu trả lời + OCR: gemini | openai
LLM_PROVIDER=gemini
# Provider tạo embedding: gemini | openai
# Đổi provider/model embedding thì phải bấm "Re-index" cho từng bộ tài liệu.
EMBED_PROVIDER=gemini

# --- Gemini (lấy key tại https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# low | medium | high (gemini-3.8-flash không hỗ trợ minimal)
GEMINI_THINKING_LEVEL=low
GEMINI_EMBED_MODEL=gemini-embedding-2
# 768 | 1536 | 3072
GEMINI_EMBED_DIM=1536

# --- OpenAI ---
OPENAI_API_KEY=
# gpt-6.1-terra (cân bằng) | gpt-6-luna (rẻ nhất) | gpt-6.1-sol (mạnh hơn)
OPENAI_CHAT_MODEL=gpt-6.1-terra
# none | low | medium | high
OPENAI_REASONING_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Tavily (tìm kiếm internet, https://app.tavily.com) ---
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# --- Tìm kiếm trong tài liệu ---
# Số đoạn tài liệu đưa cho LLM mỗi câu hỏi
TOP_K=8
# Nếu > 0: đoạn tốt nhất có độ tương đồng cosine thấp hơn ngưỡng này thì coi như
# không tìm thấy, khỏi gọi LLM. Mặc định 0 = tắt, để LLM tự đánh giá.
MIN_SIMILARITY=0
# Số trang OCR song song
OCR_WORKERS=4
